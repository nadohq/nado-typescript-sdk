{
  "name": "@nadohq/otc-client",
  "version": "0.49.0",
  "type": "module",
  "sideEffects": false,
  "description": "HTTP client for the Nado OTC service - execute a signed fill-or-kill order, read its status, and build RFQ quote subscriptions",
  "author": "Frank Jia <frank@inkfnd.com>",
  "homepage": "",
  "license": "ISC",
  "source": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/nadohq/nado-typescript-sdk",
  "scripts": {
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsdown",
    "dev": "tsc -w",
    "lint": "eslint --cache './**/*.{ts,tsx}'",
    "lint:fix": "eslint --cache --fix './**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "react-native": "./dist/index.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@nadohq/engine-client": "^0.49.0",
    "@nadohq/shared": "^0.49.0",
    "axios": "1.16.1"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1"
  }
}
