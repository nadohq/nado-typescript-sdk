{
  "name": "@nadohq/client",
  "version": "0.42.1",
  "type": "module",
  "sideEffects": false,
  "description": "Nado SDK client — unified API for trading, market data, and collateral management on Nado",
  "author": "Frank Jia <frank@inkfnd.com>",
  "homepage": "",
  "license": "ISC",
  "source": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/nadohq/nado-typescript-sdk",
  "scripts": {
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsdown",
    "dev": "tsc -w",
    "lint": "eslint --cache './**/*.{ts,tsx}'",
    "lint:fix": "eslint --cache --fix './**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "react-native": "./dist/index.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@nadohq/engine-client": "^0.42.1",
    "@nadohq/indexer-client": "^0.42.1",
    "@nadohq/mobile-client": "^0.42.1",
    "@nadohq/nuanze-client": "^0.42.1",
    "@nadohq/shared": "^0.42.1",
    "@nadohq/trigger-client": "^0.42.1",
    "ts-mixer": "6.0.4"
  },
  "peerDependencies": {
    "bignumber.js": "11.1.1",
    "viem": "2.52.0"
  },
  "devDependencies": {
    "bignumber.js": "11.1.1",
    "viem": "2.52.0"
  },
  "gitHead": "1a1e9b62edb6b6578d8dc00dbf4591c6852a5c78"
}
