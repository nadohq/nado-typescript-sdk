{
  "name": "@nadohq/shared",
  "version": "0.8.0",
  "type": "module",
  "sideEffects": false,
  "description": "Shared utilities, types, and contract helpers for Nado SDK",
  "author": "Frank Jia <frank@inkfnd.com>",
  "homepage": "",
  "license": "ISC",
  "source": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": "https://github.com/nadohq/nado-typescript-sdk",
  "scripts": {
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "build": "tsup",
    "dev": "tsc -w",
    "lint": "eslint --cache './**/*.{ts,tsx}'",
    "lint:fix": "eslint --cache --fix './**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "react-native": "./dist/index.js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "abitype": "1.2.3"
  },
  "peerDependencies": {
    "bignumber.js": "^10.0.0",
    "viem": "^2.41.0"
  },
  "devDependencies": {
    "@jest/globals": "30.2.0",
    "bignumber.js": "10.0.2",
    "viem": "2.41.2"
  },
  "gitHead": "63b6e169f6fa4330ca4789821b977e286801a943"
}
